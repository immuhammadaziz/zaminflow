# Copy to .env for local development. Replace the placeholder password before use.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
DATABASE_URL=postgres://zaminflow:change-me-local-only@localhost:5432/zaminflow?sslmode=disable
POSTGRES_DB=zaminflow
POSTGRES_USER=zaminflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
API_PORT=8080
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SWAGGER_PORT=8081
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_CONNECT_TIMEOUT=5s
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_REQUEST_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
MIGRATIONS_DIR=migrations
CORS_ALLOWED_ORIGINS=https://www.zaminflow.uz,https://zaminflow.uz,http://localhost:3000,http://localhost:5173
