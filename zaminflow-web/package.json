{
  "name": "zaminflow-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.0",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "generate-client": "node scripts/generate-client.mjs",
    "check-client-drift": "node scripts/check-client-drift.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "audit": "pnpm audit --prod --audit-level high",
    "licenses": "pnpm licenses list --production",
    "sync-openapi": "node scripts/sync-openapi.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:translations && pnpm check-client-drift && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.105.3",
    "clsx": "2.1.1",
    "lucide-react": "1.67.0",
    "next": "16.4.4",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.17.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-security": "4.2.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
